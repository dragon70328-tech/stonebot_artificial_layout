{
  "name": "canada_ifc",
  "version": "1.0.0",
  "description": "加拿大IFC.dxf 读图画像：面板边界位于图层 0，编号位于图层 编号；编号格式如 D1-1E、D2-4E、A-29-B。",
  "panel_layers": [
    "0"
  ],
  "hole_layers": [
    "0"
  ],
  "hatch_layer": null,
  "use_hatch": false,
  "number_layers": [
    "编号"
  ],
  "label_pattern": "^[A-Z]\\d?-\\d+[A-Z]?(?:-[A-Z])?$",
  "material_prefix_pattern": "^[A-Z]\\d?",
  "allowed_material_prefixes": [],
  "assignment_mode": "point_then_bbox",
  "bbox_overlap_threshold": 0.5,
  "build_hierarchy": true,
  "conflict_resolution": "random",
  "closed_tolerance": 0.01,
  "exclude_entity_types": [],
  "exclude_linetypes": [
    "ZIGZAG",
    "DASH",
    "PHANTOM"
  ],
  "text_height": 40.0,
  "small_area_threshold": 50000.0,
  "material_group_enabled": false,
  "first_part_left_edge": false,
  "expected_counts": {
    "panels": 766,
    "holes": 0,
    "numbers": 765
  },
  "notes": "加拿大IFC：识别 766 件面板，编号层 765 个编号文本；存在 1 个重复编号文本与 1 个无匹配面板的编号，需用户在排板前确认。"
}
